{
  "name": "@stay/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "stay-infra": "dist/bin/stay.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run lib/stay-demo-stack.test.ts",
    "test:coverage": "vitest run lib/stay-demo-stack.test.ts --coverage",
    "synth": "pnpm build && cdk synth --strict --quiet",
    "diff": "pnpm build && cdk diff --strict",
    "deploy": "pnpm build && cdk deploy --require-approval broadening"
  },
  "dependencies": {
    "aws-cdk-lib": "2.267.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1",
    "source-map-support": "0.5.21"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "aws-cdk": "2.1139.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
