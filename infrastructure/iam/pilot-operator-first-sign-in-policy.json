{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadPasswordPolicy",
      "Effect": "Allow",
      "Action": "iam:GetAccountPasswordPolicy",
      "Resource": "*"
    },
    {
      "Sid": "AllowChangeOwnPassword",
      "Effect": "Allow",
      "Action": "iam:ChangePassword",
      "Resource": "arn:aws:iam::828547077857:user/${aws:username}"
    },
    {
      "Sid": "AllowViewVirtualMfaDevices",
      "Effect": "Allow",
      "Action": "iam:ListVirtualMFADevices",
      "Resource": "*"
    },
    {
      "Sid": "AllowCreateVirtualMfaDevice",
      "Effect": "Allow",
      "Action": "iam:CreateVirtualMFADevice",
      "Resource": "arn:aws:iam::828547077857:mfa/*"
    },
    {
      "Sid": "AllowManageOwnMfa",
      "Effect": "Allow",
      "Action": [
        "iam:EnableMFADevice",
        "iam:GetMFADevice",
        "iam:GetUser",
        "iam:ListMFADevices",
        "iam:ResyncMFADevice"
      ],
      "Resource": "arn:aws:iam::828547077857:user/${aws:username}"
    },
    {
      "Sid": "AllowAssumeOnlyPilotOperatorRole",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::828547077857:role/stay-pilot-household-operator-role"
    }
  ]
}
