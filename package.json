{
  "name": "stay",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @stay/web test:e2e",
    "capture:submission": "pnpm --filter @stay/web capture:submission",
    "captions:submission": "pnpm --filter @stay/web captions:submission",
    "render:submission": "pnpm --filter @stay/web render:submission",
    "verify:submission": "pnpm --filter @stay/web verify:submission",
    "cdk:synth": "pnpm --filter @stay/infra synth",
    "cdk:diff": "pnpm --filter @stay/infra diff",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm cdk:synth"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.4.1",
    "eslint": "9.39.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
