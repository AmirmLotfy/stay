    "capture:submission": "node scripts/capture-submission.mjs",
    "captions:submission": "node scripts/generate-submission-captions.mjs",
    "render:submission": "node scripts/render-submission-video.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@stay/contracts": "workspace:*",
    "@stay/domain": "workspace:*",
    "jose": "6.2.10",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
