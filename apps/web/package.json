{
  "name": "@stay/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "npx serve@14 out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "verify:live:mcp": "node scripts/verify-live-mcp.mjs",
    "verify:submission": "node scripts/verify-submission-package.mjs",
